#!/usr/bin/env sh

# Minimal Gradle Wrapper launcher. The wrapper JAR and its distribution checksum
# are versioned with this project so contributors do not need Gradle installed.
APP_HOME=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

exec java ${JAVA_OPTS:-} ${GRADLE_OPTS:-} \
  -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
